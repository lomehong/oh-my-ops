#!/usr/bin/env bash
# pre-push：本地全量预跑 test:ci（13 步，含 l1/l2/typecheck 及安装与探针共 13 步）；
# CI 的 test job 只跑其中 test:l1 / test:l2 / typecheck:core 三步（同一组脚本，防 runner 分裂），
# 其余步骤（探针/安装/发布完整性）只在本地与 release.yml 的发布校验里跑——本地更严，不漏。
# 启用：npm run hooks:install   跳过一次：OMO_SKIP_HOOKS=1 git push
set -euo pipefail

if [ "${OMO_SKIP_HOOKS:-}" = "1" ]; then
	echo "pre-push: OMO_SKIP_HOOKS=1，跳过本地 CI 预跑"
	exit 0
fi

cd "$(git rev-parse --show-toplevel)"
echo "pre-push: npm run test:ci（本地全量 13 步；CI test job 为其中 l1/l2/typecheck 三步）"
npm run test:ci
